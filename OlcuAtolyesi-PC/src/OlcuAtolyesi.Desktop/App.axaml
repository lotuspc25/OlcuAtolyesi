<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OlcuAtolyesi.Desktop.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme />

        <!-- Kurumsal Koyu Tema Temel Stilleri -->
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#F0F5FA" />
            <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif" />
        </Style>

        <Style Selector="Button">
            <Setter Property="Foreground" Value="#F0F5FA" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Foreground" Value="#F0F5FA" />
            <Setter Property="Background" Value="#121820" />
            <Setter Property="BorderBrush" Value="#2B394A" />
        </Style>
    </Application.Styles>
</Application>
