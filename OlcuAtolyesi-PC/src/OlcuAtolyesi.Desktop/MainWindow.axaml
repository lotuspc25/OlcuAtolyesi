<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OlcuAtolyesi.Desktop.ViewModels"
        x:Class="OlcuAtolyesi.Desktop.MainWindow"
        x:DataType="vm:DesktopMainViewModel"
        Title="{Binding WindowTitle}"
        Width="1240" Height="800"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#0F141A"
        Foreground="#F0F5FA">

    <Grid ColumnDefinitions="270,*" RowDefinitions="*,32">
        <!-- SOL NAVİGASYON MENÜSÜ -->
        <Border Grid.Row="0" Grid.Column="0" Background="#151C24" BorderBrush="#2B394A" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,16,12,12">
                <!-- Üst Logo ve Başlık -->
                <StackPanel DockPanel.Dock="Top" Margin="4,0,4,16" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="📐" FontSize="22" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AppTitle}" FontSize="18" FontWeight="Bold" Foreground="#F0F5FA" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding PlatformVersionText}" FontSize="11.5" Foreground="#0E9AA7" Margin="30,0,0,0" FontWeight="SemiBold" />

                    <!-- Platform Rozeti (Linux Debian / Windows) -->
                    <Border Background="#16353D" BorderBrush="#0E9AA7" BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="0,8,0,0">
                        <TextBlock Text="{Binding PlatformBadge}" FontSize="11" FontWeight="Bold" Foreground="#4CE095" HorizontalAlignment="Center" />
                    </Border>
                </StackPanel>

                <!-- Alt Bölüm: Tanılama Konsolu ve Sistem Durumu -->
                <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
                    <Button HorizontalAlignment="Stretch" Padding="10,8" CornerRadius="6"
                            Background="#1B2430" BorderBrush="#2B394A" BorderThickness="1"
                            Command="{Binding ToggleDiagnosticConsoleCommand}">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Background="#16353D" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="Canlı" FontSize="10" FontWeight="Bold" Foreground="#0E9AA7" />
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="🖥️" FontSize="13" />
                                <TextBlock Text="Tanılama Konsolu" FontSize="12" FontWeight="SemiBold" Foreground="#F0F5FA" />
                            </StackPanel>
                        </DockPanel>
                    </Button>

                    <Border Background="#212C3A" CornerRadius="6" Padding="10,8">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{Binding MachineUser}" FontSize="10.5" FontWeight="SemiBold" Foreground="#F0F5FA" />
                            <TextBlock Text="{Binding OsDescription}" FontSize="9.5" Foreground="#77889B" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 9 Modüllü Navigasyon Listesi -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DesktopNavMenuItem}">
                                <Button Command="{Binding SelectCommand}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,4"
                                        Padding="10,8"
                                        CornerRadius="6"
                                        Background="{Binding IsSelected, ConverterParameter=#16353D}"
                                        BorderBrush="{Binding IsSelected, ConverterParameter=#0E9AA7}"
                                        BorderThickness="1">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Background="#283240" CornerRadius="4" Padding="5,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StateBadge}" FontSize="9.5" Foreground="#9AB0C7" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding IconGlyph}" Width="18" FontSize="13" Foreground="#0E9AA7" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="#F0F5FA" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- SAĞ ANA İÇERİK ALANI -->
        <DockPanel Grid.Row="0" Grid.Column="1" Margin="24,18,24,12">
            <!-- Üst Başlık Çubuğu -->
            <Border DockPanel.Dock="Top" BorderBrush="#2B394A" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,16">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Background="#212C3A" BorderBrush="#2B394A" BorderThickness="1" CornerRadius="6" Padding="12,5" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentModuleStateBadge}" FontWeight="Bold" FontSize="11.5" Foreground="#0E9AA7" />
                    </Border>
                    <StackPanel Spacing="3">
                        <TextBlock Text="{Binding CurrentModuleTitle}" FontSize="20" FontWeight="Bold" Foreground="#F0F5FA" />
                        <TextBlock Text="{Binding CurrentModuleSubtitle}" FontSize="12" Foreground="#77889B" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Modül İçerikleri -->
            <Panel>
                <!-- 1. ANA PANEL (DASHBOARD) -->
                <ScrollViewer IsVisible="{Binding IsDashboard}">
                    <StackPanel Spacing="16">
                        <!-- Özet Rozet Kartı -->
                        <Border Background="#1B2430" BorderBrush="#2B394A" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Masaüstü Çalışma Alanı ve Modül Durumu" FontSize="16" FontWeight="Bold" Foreground="#F0F5FA" />
                                <TextBlock Text="Bu arayüz hem Windows masaüstünde hem de Linux (Debian 10/11/12, Ubuntu vb.) üzerinde sanal makine veya emülatör gerektirmeden bağımsız yerel pencere olarak çalışır."
                                           FontSize="12.5" Foreground="#A3B3C6" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,6,0,0">
                                    <Border Background="#163B2B" CornerRadius="5" Padding="10,4" Margin="0,0,8,4">
                                        <TextBlock Text="Etkin Modül: 5" FontSize="11" FontWeight="Bold" Foreground="#4CE095" />
                                    </Border>
                                    <Border Background="#3F3116" CornerRadius="5" Padding="10,4" Margin="0,0,8,4">
                                        <TextBlock Text="Temeli Hazır: 2" FontSize="11" FontWeight="Bold" Foreground="#F5B942" />
                                    </Border>
                                    <Border Background="#283240" CornerRadius="5" Padding="10,4" Margin="0,0,8,4">
                                        <TextBlock Text="Planlanan Modül: 2" FontSize="11" FontWeight="Bold" Foreground="#9AB0C7" />
                                    </Border>
                                    <Border Background="#16353D" CornerRadius="5" Padding="10,4" Margin="0,0,8,4">
                                        <TextBlock Text="Ortak Çekirdek: OlcuAtolyesi.Core (.NET 10)" FontSize="11" FontWeight="Bold" Foreground="#0E9AA7" />
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Modül Durumları ve Hızlı Geçiş" FontSize="15" FontWeight="Bold" Foreground="#F0F5FA" Margin="0,4,0,4" />

                        <!-- Modül Kartları Izgarası -->
                        <ItemsControl ItemsSource="{Binding DashboardCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DashboardModuleCardItem}">
                                    <Border Background="#1B2430" BorderBrush="#2B394A" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,12">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top">
                                                <Border DockPanel.Dock="Right" Background="#283240" CornerRadius="4" Padding="6,2" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding StateBadge}" FontSize="10" FontWeight="SemiBold" Foreground="#9AB0C7" />
                                                </Border>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding IconGlyph}" FontSize="16" Foreground="#0E9AA7" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="#F0F5FA" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DockPanel>

                                            <Button DockPanel.Dock="Bottom" Content="Modülü Aç →" Command="{Binding OpenCommand}"
                                                    Background="#212C3A" BorderBrush="#2B394A" BorderThickness="1"
                                                    Foreground="#0E9AA7" CornerRadius="6" Padding="12,6" HorizontalAlignment="Left" Margin="0,12,0,0" />

                                            <StackPanel Margin="0,8,0,0" Spacing="4">
                                                <TextBlock Text="{Binding ShortSummary}" TextWrapping="Wrap" FontSize="12" Foreground="#A3B3C6" />
                                                <TextBlock Text="{Binding TargetVersion, StringFormat='Hedef: {0}'}" FontSize="11" Foreground="#77889B" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- 2. PROJELER (PROJECTS) -->
                <ScrollViewer IsVisible="{Binding IsProjects}">
                    <StackPanel Spacing="16">
                        <Border Background="#1B2430" BorderBrush="#2B394A" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="10">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Background="#163B2B" CornerRadius="5" Padding="10,4">
                                        <TextBlock Text="{Binding Projects.Count, StringFormat='Kayıtlı Proje: {0}'}" FontWeight="Bold" Foreground="#4CE095" />
                                    </Border>
                                    <TextBlock Text="Kalıcı Proje Depolama ve Yönetimi" FontSize="16" FontWeight="Bold" Foreground="#F0F5FA" />
                                </DockPanel>
                                <TextBlock Text="{Binding ProjectStatusMessage}" FontSize="12" Foreground="#A3B3C6" />

                                <Grid ColumnDefinitions="*,12,Auto" Margin="0,8,0,0">
                                    <TextBox Grid.Column="0" Text="{Binding NewProjectName}" PlaceholderText="Yeni proje adı..." CornerRadius="6" Padding="10,7" />
                                    <Button Grid.Column="2" Content="+ Yeni Proje Oluştur" Command="{Binding CreateProjectCommand}"
                                            Background="#0E9AA7" Foreground="#0F141A" FontWeight="Bold" CornerRadius="6" Padding="14,8" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="#1B2430" BorderBrush="#2B394A" BorderThickness="1" CornerRadius="8" Padding="16">
                            <ItemsControl ItemsSource="{Binding Projects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#151C24" BorderBrush="#2B394A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding UpdatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" FontSize="11" Foreground="#77889B" VerticalAlignment="Center" />
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="#F0F5FA" />
                                                    <TextBlock Text="{Binding MeasuredLength, StringFormat='Ölçülen Değer: {0}'}" FontSize="12" Foreground="#0E9AA7" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. TELEFON BAĞLANTISI (PHONE CONNECTION) -->
                <ScrollViewer IsVisible="{Binding IsPhoneConnection}">
                    <StackPanel Spacing="16">
                        <Border Background="#1B2430" BorderBrush="#2B394A" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Android Cihaz Denetimi (USB ADB &amp; Wi-Fi)" FontSize="16" FontWeight="Bold" Foreground="#F0F5FA" />
                                <TextBlock Text="Bağlı Android telefonları USB ADB üzerinden denetleyin veya Wi-Fi üzerinden kamera servisine bağlanın." FontSize="12.5" Foreground="#A3B3C6" />

                                <Border Background="#151C24" BorderBrush="#2B394A" BorderThickness="1" CornerRadius="6" Padding="14">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="ADB Sürücü &amp; Cihaz Durumu:" FontWeight="Bold" Foreground="#0E9AA7" FontSize="11.5" />
                                        <TextBlock Text="{Binding PhoneStatusText}" FontSize="12" Foreground="#F0F5FA" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <DockPanel Margin="0,6,0,0">
                                    <Button Content="🔄 Cihazları Yeniden Tara (ADB)" Command="{Binding ProbeAdbCommand}"
                                            Background="#212C3A" BorderBrush="#2B394A" BorderThickness="1" CornerRadius="6" Padding="12,7" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 4. KAMERA VE KALİBRASYON (CAMERA STREAM) -->
                <ScrollViewer IsVisible="{Binding IsCameraCalibration}">
                    <StackPanel Spacing="16">
                        <Border Background="#1B2430" BorderBrush="#2B394A" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Wi-Fi MJPEG Kamera Servisi ve Uzaktan Fotoğraf Çekimi" FontSize="16" FontWeight="Bold" Foreground="#F0F5FA" />
                                <TextBlock Text="Ölçü Atölyesi Android uygulamasındaki 'PC Kamera Bağlantısı' ekranında gösterilen IP ve PIN kodunu giriniz." FontSize="12.5" Foreground="#A3B3C6" />

                                <Grid ColumnDefinitions="*,10,120,10,120,10,Auto">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="Telefon IP Adresi" FontSize="11" Foreground="#77889B" />
                                        <TextBox Text="{Binding PhoneIp}" Padding="8,6" CornerRadius="6" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Text="Port" FontSize="11" Foreground="#77889B" />
                                        <TextBox Text="{Binding PhonePort}" Padding="8,6" CornerRadius="6" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Spacing="4">
                                        <TextBlock Text="PIN Kodu" FontSize="11" Foreground="#77889B" />
                                        <TextBox Text="{Binding PhonePin}" Padding="8,6" CornerRadius="6" />
                                    </StackPanel>
                                    <Button Grid.Column="6" Content="Yayına Bağlan" Command="{Binding TestPhoneConnectionCommand}"
                                            VerticalAlignment="Bottom" Background="#0E9AA7" Foreground="#0F141A" FontWeight="Bold" CornerRadius="6" Padding="14,8" />
                                </Grid>

                                <Border Background="#151C24" BorderBrush="#2B394A" BorderThickness="1" CornerRadius="6" Padding="14">
                                    <TextBlock Text="{Binding PhoneStatusText}" FontSize="12" Foreground="#F0F5FA" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 5. FOTOĞRAFTAN ÖLÇÜM (PHOTO MEASUREMENT - ANA STÜDYO) -->
                <ScrollViewer IsVisible="{Binding IsPhotoMeasurement}">
                    <StackPanel Spacing="14">
                        <!-- Üst Kontrol & Referans Çubuğu -->
                        <Border Background="#1B2430" BorderBrush="#2B394A" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel Spacing="10">
                                <DockPanel>
                                    <TextBlock Text="Fotoğraftan Ölçüm ve Kalibrasyon Stüdyosu" FontSize="15" FontWeight="Bold" Foreground="#F0F5FA" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" Spacing="6" DockPanel.Dock="Right">
                                        <Button Content="Kart (85.6 mm)" Command="{Binding SetDemoCardPointsCommand}" Background="#212C3A" CornerRadius="5" Padding="8,4" FontSize="11.5" />
                                        <Button Content="A4 (210 mm)" Command="{Binding SetDemoA4PointsCommand}" Background="#212C3A" CornerRadius="5" Padding="8,4" FontSize="11.5" />
                                        <Button Content="📐 DXF İhraç Et" Command="{Binding ExportDxfCommand}" Background="#4CE095" Foreground="#0F141A" FontWeight="Bold" CornerRadius="5" Padding="10,5" FontSize="11.5" />
                                    </StackPanel>
                                </DockPanel>

                                <Grid ColumnDefinitions="*,*,*,*">
                                    <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,6,0">
                                        <TextBlock Text="Referans Şablonu" FontSize="11" Foreground="#77889B" />
                                        <TextBox Text="{Binding SelectedReferenceObjectName}" Padding="6,4" CornerRadius="5" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="3" Margin="0,0,6,0">
                                        <TextBlock Text="Referans (mm)" FontSize="11" Foreground="#77889B" />
                                        <NumericUpDown Value="{Binding KnownReferenceLength}" Minimum="0.1" Maximum="10000" Increment="1" Padding="6,4" CornerRadius="5" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="3" Margin="0,0,6,0">
                                        <TextBlock Text="Ölçek Faktörü" FontSize="11" Foreground="#77889B" />
                                        <TextBlock Text="{Binding ScaleMmPerPixel, StringFormat='{}{0:F4} mm/px'}" FontSize="13" FontWeight="Bold" Foreground="#F5B942" VerticalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Spacing="3">
                                        <TextBlock Text="Hesaplanan Ölçüm" FontSize="11" Foreground="#77889B" />
                                        <TextBlock Text="{Binding CalculatedResultText}" FontSize="14" FontWeight="Bold" Foreground="#4CE095" VerticalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- A Cetveli, B Cetveli ve Büyüteç Araç Çubuğu -->
                        <Border Background="#151C24" BorderBrush="#2B394A" BorderThickness="1" CornerRadius="8" Padding="10">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Araçlar:" FontWeight="Bold" Foreground="#0E9AA7" VerticalAlignment="Center" FontSize="12" />
                                    <Button Content="🔍 Büyüteç" Command="{Binding ToggleMagnifierCommand}" Background="#212C3A" CornerRadius="5" Padding="8,4" FontSize="11" />
                                    <Button Content="2x" Command="{Binding SetZoom2Command}" Background="#212C3A" CornerRadius="5" Padding="6,4" FontSize="11" />
                                    <Button Content="4x" Command="{Binding SetZoom4Command}" Background="#212C3A" CornerRadius="5" Padding="6,4" FontSize="11" />
                                    <Button Content="8x" Command="{Binding SetZoom8Command}" Background="#212C3A" CornerRadius="5" Padding="6,4" FontSize="11" />
                                    <Separator Width="1" Height="16" Background="#2B394A" Margin="4,0" />
                                    <Button Content="Filtreleri Sıfırla" Command="{Binding ResetFiltersCommand}" Background="#212C3A" CornerRadius="5" Padding="8,4" FontSize="11" />
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Right" Text="A Cetveli (Parça mm) • B Cetveli (Ekran 1:1 mm)" FontSize="11" Foreground="#77889B" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <!-- Ana Ölçüm Tuvali -->
                        <Border Background="#121820" BorderBrush="#2B394A" BorderThickness="1" CornerRadius="8" Height="360" ClipToBounds="True">
                            <Panel>
                                <!-- Arka Plan Izgara Çizgileri -->
                                <Border BorderBrush="#1B2430" BorderThickness="1" Margin="16" CornerRadius="6">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                                        <TextBlock Text="Ölçüm Alanı (R1-R2 Referans / M1-M2 Ölçüm)" FontSize="15" FontWeight="Bold" Foreground="#2B394A" HorizontalAlignment="Center" />
                                        <TextBlock Text="Mavi Hat: Referans | Sarı Hat: Ölçülen Parça" FontSize="11.5" Foreground="#283240" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Canvas>
                                    <!-- Referans Segmenti (R1–R2) -->
                                    <Line StartPoint="150,240" EndPoint="550,240" Stroke="#0E9AA7" StrokeThickness="3" />
                                    <Ellipse Canvas.Left="142" Canvas.Top="232" Width="16" Height="16" Fill="#0E9AA7" />
                                    <TextBlock Canvas.Left="138" Canvas.Top="210" Text="R1" FontWeight="Bold" Foreground="#0E9AA7" FontSize="12" />
                                    <Ellipse Canvas.Left="542" Canvas.Top="232" Width="16" Height="16" Fill="#0E9AA7" />
                                    <TextBlock Canvas.Left="540" Canvas.Top="210" Text="R2" FontWeight="Bold" Foreground="#0E9AA7" FontSize="12" />
                                    <TextBlock Canvas.Left="310" Canvas.Top="248" Text="Referans: 85.60 mm" FontSize="11" Foreground="#0E9AA7" FontWeight="SemiBold" />

                                    <!-- Ölçüm Segmenti (M1–M2) -->
                                    <Line StartPoint="150,130" EndPoint="750,130" Stroke="#F5B942" StrokeThickness="3" StrokeDashArray="5,3" />
                                    <Ellipse Canvas.Left="142" Canvas.Top="122" Width="16" Height="16" Fill="#F5B942" />
                                    <TextBlock Canvas.Left="138" Canvas.Top="100" Text="M1" FontWeight="Bold" Foreground="#F5B942" FontSize="12" />
                                    <Ellipse Canvas.Left="742" Canvas.Top="122" Width="16" Height="16" Fill="#F5B942" />
                                    <TextBlock Canvas.Left="740" Canvas.Top="100" Text="M2" FontWeight="Bold" Foreground="#F5B942" FontSize="12" />

                                    <!-- Ölçüm Sonuç Etiketi -->
                                    <Border Canvas.Left="400" Canvas.Top="96" Background="#1B2430" BorderBrush="#F5B942" BorderThickness="1" CornerRadius="5" Padding="8,3">
                                        <TextBlock Text="{Binding CalculatedResultText}" FontSize="12" FontWeight="Bold" Foreground="#F5B942" />
                                    </Border>
                                </Canvas>
                            </Panel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 6. CAD İHRACI (CAD EXPORT) -->
                <ScrollViewer IsVisible="{Binding IsCadExport}">
                    <StackPanel Spacing="16">
                        <Border Background="#1B2430" BorderBrush="#2B394A" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Vektörel 2B DXF / STEP / STL İhracı" FontSize="16" FontWeight="Bold" Foreground="#F0F5FA" />
                                <TextBlock Text="Ölçülen geometriler AutoCAD R12 ASCII DXF formatında milimetrik koordinatlarla dışa aktarılır. AutoCAD, SolidWorks, FreeCAD ve tüm CNC/lazer kesim programlarında doğrudan açılabilir."
                                           FontSize="12.5" Foreground="#A3B3C6" TextWrapping="Wrap" />
                                <DockPanel Margin="0,10,0,0">
                                    <Button Content="📐 DXF Dosyası Üret ve Kaydet" Command="{Binding ExportDxfCommand}"
                                            Background="#0E9AA7" Foreground="#0F141A" FontWeight="Bold" CornerRadius="6" Padding="14,8" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 7. 3B BASKI HAZIRLIĞI (PRINT 3D) -->
                <ScrollViewer IsVisible="{Binding IsPrint3D}">
                    <StackPanel Spacing="16">
                        <Border Background="#1B2430" BorderBrush="#2B394A" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="8">
                                <TextBlock Text="3B Baskı Hazırlığı &amp; Dilimleyici Entegrasyonu" FontSize="16" FontWeight="Bold" Foreground="#F0F5FA" />
                                <TextBlock Text="OrcaSlicer ve PrusaSlicer CLI motorları üzerinden ölçülen profillerin doğrudan 3B baskı dilimleme formatına aktarılması planlanmıştır."
                                           FontSize="12.5" Foreground="#A3B3C6" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 8. AYARLAR & YAPILANDIRMA (SETTINGS) -->
                <ScrollViewer IsVisible="{Binding IsSettings}">
                    <StackPanel Spacing="16">
                        <Border Background="#1B2430" BorderBrush="#2B394A" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Uygulama Tercihleri ve Çalışma Alanı" FontSize="16" FontWeight="Bold" Foreground="#F0F5FA" />

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Depolama Dizini (Workspace)" FontSize="12" FontWeight="SemiBold" Foreground="#F0F5FA" />
                                    <TextBox Text="{Binding WorkspacePath}" IsReadOnly="True" CornerRadius="6" Padding="8,6" />
                                    <TextBlock Text="Linux'ta ~/.local/share/OlcuAtolyesiPC, Windows'ta AppData/Local altında saklanır." FontSize="11" Foreground="#77889B" />
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Görünüm Teması" FontSize="12" FontWeight="SemiBold" Foreground="#F0F5FA" />
                                    <TextBlock Text="Kurumsal Koyu Tema (Etkin)" FontSize="12" Foreground="#0E9AA7" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 9. YARDIM & KULLANIM KILAVUZU (HELP) -->
                <ScrollViewer IsVisible="{Binding IsHelp}">
                    <StackPanel Spacing="16">
                        <Border Background="#1B2430" BorderBrush="#2B394A" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Hızlı Kullanım Rehberi ve Kısayollar" FontSize="16" FontWeight="Bold" Foreground="#F0F5FA" />
                                <TextBlock Text="1. Adım: Fotoğraftan Ölçüm modülüne geçin.&#10;2. Adım: Referans nesnesi seçin (Banka kartı 85.6 mm vb.).&#10;3. Adım: R1 ve R2 noktalarını referansın iki ucuna koyun.&#10;4. Adım: M1 ve M2 noktalarını ölçmek istediğiniz parçaya yerleştirin.&#10;5. Adım: Sonucu canlı görün ve 'DXF Olarak Kaydet' ile CAD çıktısını alın."
                                           FontSize="12.5" Foreground="#A3B3C6" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- TANILAMA KONSOLU PANELİ (AÇILIR/KAPANIR) -->
                <Border IsVisible="{Binding IsDiagnosticConsoleOpen}" Background="#0F141A" BorderBrush="#0E9AA7" BorderThickness="1" CornerRadius="8" Margin="0,0,0,0">
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0" Background="#151C24" BorderBrush="#2B394A" BorderThickness="0,0,0,1" Padding="14,10">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="✕ Kapat" Command="{Binding ToggleDiagnosticConsoleCommand}"
                                        Background="#283240" CornerRadius="5" Padding="8,4" FontSize="11" />
                                <Button DockPanel.Dock="Right" Content="Temizle" Command="{Binding ClearLogsCommand}"
                                        Background="#212C3A" CornerRadius="5" Padding="8,4" FontSize="11" Margin="0,0,8,0" />
                                <TextBlock Text="🖥️ Canlı Tanılama ve Olay Konsolu" FontSize="14" FontWeight="Bold" Foreground="#F0F5FA" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1" Padding="12">
                            <ItemsControl ItemsSource="{Binding Logs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#1B2430" BorderThickness="0,0,0,1" Padding="4,3">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss.fff}'}" FontSize="10.5" Foreground="#77889B" Margin="0,0,8,0" />
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Level}" FontSize="10.5" FontWeight="Bold" Foreground="#0E9AA7" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding Message}" FontSize="11" Foreground="#F0F5FA" TextWrapping="Wrap" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Panel>
        </DockPanel>

        <!-- ALT DURUM ÇUBUĞU -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="#151C24" BorderBrush="#2B394A" BorderThickness="0,1,0,0" Padding="14,0">
            <DockPanel VerticalAlignment="Center">
                <TextBlock DockPanel.Dock="Right" Text="{Binding VersionText}" FontSize="11" Foreground="#77889B" />
                <TextBlock DockPanel.Dock="Right" Text="Ortak Çekirdek: OlcuAtolyesi.Core (.NET 10) | " FontSize="11" Foreground="#77889B" Margin="0,0,6,0" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="7" Height="7" Fill="#4CE095" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" Foreground="#F0F5FA" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
