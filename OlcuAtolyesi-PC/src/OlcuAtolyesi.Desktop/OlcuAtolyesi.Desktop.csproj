<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>OlcuAtolyesi.Desktop</RootNamespace>
    <AssemblyName>OlcuAtolyesi.Desktop</AssemblyName>
    <Version>0.6.8</Version>
    <AssemblyVersion>0.6.8</AssemblyVersion>
    <FileVersion>0.6.8</FileVersion>
    <Product>Ölçü Atölyesi Çapraz Masaüstü (Linux &amp; Windows)</Product>
    <Company>Ölçü Atölyesi</Company>
    <Description>Ölçü Atölyesi Çapraz Masaüstü Uygulaması (Linux Debian &amp; Windows)</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OlcuAtolyesi.Core\OlcuAtolyesi.Core.csproj" />
  </ItemGroup>
</Project>
