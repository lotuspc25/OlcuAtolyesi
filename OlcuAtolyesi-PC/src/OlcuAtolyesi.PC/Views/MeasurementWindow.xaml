<Window x:Class="OlcuAtolyesi.PC.Views.MeasurementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:OlcuAtolyesi.PC.Controls"
        Title="Ölçüm Çalışma Alanı — Ölçü Atölyesi"
        Icon="pack://application:,,,/OlcuAtolyesi.PC;component/Resources/app.ico"
        Width="1280" Height="860"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI">

    <Window.InputBindings>
        <KeyBinding Key="L" Command="{Binding ToggleMagnifierCommand}" />
        <KeyBinding Key="D2" Command="{Binding MagnifierZoom2Command}" />
        <KeyBinding Key="D4" Command="{Binding MagnifierZoom4Command}" />
        <KeyBinding Key="D8" Command="{Binding MagnifierZoom8Command}" />
        <KeyBinding Key="Add" Command="{Binding MagnifierZoomInCommand}" />
        <KeyBinding Key="OemPlus" Command="{Binding MagnifierZoomInCommand}" />
        <KeyBinding Key="Subtract" Command="{Binding MagnifierZoomOutCommand}" />
        <KeyBinding Key="OemMinus" Command="{Binding MagnifierZoomOutCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OlcuAtolyesi.PC;component/Themes/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Segoe Fluent Icons glif stili (11 Kasım 2026'da görsel olarak doğrulanmış kodlar) -->
            <Style x:Key="IconGlyph" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            </Style>

            <Style x:Key="IconGlyphTab" TargetType="TextBlock" BasedOn="{StaticResource IconGlyph}">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Margin" Value="0,0,7,0" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Proje / fotoğraf bilgisi -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="{Binding ProjectNameInput}" FontSize="14" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
            <TextBlock Text="  •  " Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding PhotoDimensionsSummary}" FontSize="12"
                       Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Fotoğraf Aç"
                    Command="{Binding OpenPhotoCommand}" Margin="16,0,0,0" />
        </StackPanel>

        <!-- 2. Araç çubuğu + adım rehberi -->
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <Border Background="{DynamicResource CardAltBackgroundBrush}" CornerRadius="6"
                    Padding="10,7" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ADIM:" FontSize="11.5" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding ToolHint}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                </StackPanel>
            </Border>

            <TabControl Margin="0,0,0,8" Background="Transparent" BorderThickness="0">
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconGlyphTab}" Text="&#xE8B9;" />
                            <TextBlock Text="Görüntü" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <StackPanel Margin="6">
                        <WrapPanel Margin="0,0,0,4">
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ImageAdjustment.RotateLeftCommand}"
                                    ToolTip="Fotoğrafı 90° sola döndürür (noktalar birlikte döner)"
                                    Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE72C;" />
                                    <TextBlock Text="90° Sol" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ImageAdjustment.RotateRightCommand}"
                                    ToolTip="Fotoğrafı 90° sağa döndürür (noktalar birlikte döner)"
                                    Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE72C;">
                                        <TextBlock.LayoutTransform>
                                            <RotateTransform Angle="180" />
                                        </TextBlock.LayoutTransform>
                                    </TextBlock>
                                    <TextBlock Text="90° Sağ" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ImageAdjustment.Rotate180Command}"
                                    ToolTip="Fotoğrafı 180° döndürür"
                                    Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8AB;" />
                                    <TextBlock Text="180°" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ImageAdjustment.FlipHorizontalCommand}"
                                    ToolTip="Fotoğrafı yatayda aynalar"
                                    Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8AB;" />
                                    <TextBlock Text="Aynala ↔" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ImageAdjustment.FlipVerticalCommand}"
                                    ToolTip="Fotoğrafı dikeyde aynalar"
                                    Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8AB;">
                                        <TextBlock.LayoutTransform>
                                            <RotateTransform Angle="90" />
                                        </TextBlock.LayoutTransform>
                                    </TextBlock>
                                    <TextBlock Text="Aynala ↕" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ImageAdjustment.ResetAllCommand}"
                                    ToolTip="Tüm görüntü ayarlarını sıfırlar"
                                    Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE72C;" />
                                    <TextBlock Text="Orijinale Dön" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE706;" />
                                <TextBlock Text="Parlaklık" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                            <Slider Grid.Column="1" Minimum="-100" Maximum="100" TickFrequency="5"
                                    Value="{Binding ImageAdjustment.Brightness, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2" Width="34" Margin="6,0,14,0" VerticalAlignment="Center"
                                       Text="{Binding ImageAdjustment.Brightness, StringFormat={}{0:0}}"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />

                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE9E9;" />
                                <TextBlock Text="Kontrast" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                            <Slider Grid.Column="4" Minimum="-100" Maximum="100" TickFrequency="5"
                                    Value="{Binding ImageAdjustment.Contrast, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="5" Width="34" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding ImageAdjustment.Contrast, StringFormat={}{0:0}}"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </Grid>

                        <WrapPanel Margin="0,6,0,0">
                            <CheckBox IsChecked="{Binding ImageAdjustment.Grayscale}" Margin="0,0,16,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8B9;" />
                                    <TextBlock Text="Gri ton" VerticalAlignment="Center" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding ImageAdjustment.Negative}" Margin="0,0,16,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE706;" />
                                    <TextBlock Text="Negatif" VerticalAlignment="Center" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding ImageAdjustment.EdgeHighlight}" Margin="0,0,16,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE9E9;" />
                                    <TextBlock Text="Kenar vurgusu" VerticalAlignment="Center" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding ImageAdjustment.ShowGrid}" Margin="0,0,16,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8A9;" />
                                    <TextBlock Text="Izgara" VerticalAlignment="Center" />
                                </StackPanel>
                            </CheckBox>
                        </WrapPanel>
                    </StackPanel>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconGlyphTab}" Text="&#xE8EF;" />
                            <TextBlock Text="Ölçüm" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <WrapPanel Margin="6">
                        <Button Command="{Binding ReferenceToolCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                ToolTip="R1 ve R2 noktalarını işaretleyin. Kısayol: R" Padding="14,8" Margin="0,0,8,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8EF;" />
                                <TextBlock Text="R — Referans Belirle" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding MeasureToolCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                ToolTip="M1 ve M2 noktalarını işaretleyin. Kısayol: M" Padding="14,8" Margin="0,0,8,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE9E9;" />
                                <TextBlock Text="M — Mesafe Ölç" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding UndoCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="Son işlemi geri alır. Kısayol: Ctrl+Z" Margin="0,0,8,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE7A7;" />
                                <TextBlock Text="Geri Al" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ResetCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="Noktaları başlangıç konumuna döndürür. Kısayol: Delete" Margin="0,0,8,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE72C;" />
                                <TextBlock Text="Sıfırla" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CancelToolCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="Seçili aracı iptal eder. Kısayol: Esc" Margin="0,0,8,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE894;" />
                                <TextBlock Text="İptal" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding FitViewCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="Fotoğrafı pencereye sığdırır. Kısayol: F" Margin="0,0,8,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE9A6;" />
                                <TextBlock Text="Sığdır" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ToggleMagnifierCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="Büyüteci açar/kapatır. Kısayol: L" Margin="0,0,8,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE71F;" />
                                <TextBlock Text="{Binding MagnifierButtonText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CycleMagnifierZoomCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="Büyüteç oranı (2/4/8 veya +/-)" Margin="0,0,8,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8A3;" />
                                <TextBlock Text="{Binding MagnifierZoomText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconGlyphTab}" Text="&#xE8B7;" />
                            <TextBlock Text="Proje" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <WrapPanel Margin="6">
                        <Button Command="{Binding OpenPhotoCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8A7;" />
                                <TextBlock Text="Fotoğraf Aç" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SaveProjectCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE74E;" />
                                <TextBlock Text="Projeyi Kaydet" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SaveAsNewProjectCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE74E;" />
                                <TextBlock Text="Farklı Kaydet" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconGlyphTab}" Text="&#xE8AD;" />
                            <TextBlock Text="DXF" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <WrapPanel Margin="6">
                        <Button Command="{Binding ExportDxfCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8AD;" />
                                <TextBlock Text="DXF Dışa Aktar" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </TabItem>
            </TabControl>
        </StackPanel>

        <!-- 3. Tuval (pencereyi doldurur) -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                CornerRadius="6" ClipToBounds="True">
            <ctl:MeasurementCanvas Session="{Binding Session}"
                                   Image="{Binding PhotoImage}"
                                   FitRequest="{Binding FitRequest}"
                                   MagnifierEnabled="{Binding IsMagnifierEnabled, Mode=TwoWay}"
                                   MagnifierZoom="{Binding MagnifierZoom, Mode=TwoWay}"
                                   DisplaySettings="{Binding ImageAdjustment.DisplaySettings}"
                                   ShowGrid="{Binding ImageAdjustment.ShowGrid}" />
        </Border>

        <!-- 4. Durum çubuğu -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Sonuç (M1–M2):" FontSize="11.5"
                           Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CalculatedResultText}" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding DxfExportFeedback}" FontSize="12"
                       Margin="16,0,0,0" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" FontSize="11.5"
                       Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>