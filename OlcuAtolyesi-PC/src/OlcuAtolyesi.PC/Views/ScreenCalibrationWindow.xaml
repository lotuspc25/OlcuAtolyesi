<Window x:Class="OlcuAtolyesi.PC.Views.ScreenCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ekran Cetveli Kalibrasyonu — Ölçü Atölyesi"
        Width="640" Height="400"
        MinWidth="520" MinHeight="350"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI"
        ResizeMode="CanResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OlcuAtolyesi.PC;component/Themes/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="140" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Açıklama -->
        <TextBlock Grid.Row="0" Margin="0,0,0,12" FontSize="12.5" TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Text="Ekrana ölçüsünü bildiğiniz bir nesneyi koyun (ör. kredi kartı). İki çizgiyi nesnenin kenarlarına getirin, gerçek uzunluğu girin." />

        <!-- 2. Sürükleme Canvas'ı -->
        <Border Grid.Row="1" Background="{DynamicResource CardAltBackgroundBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6"
                ClipToBounds="True">
            <Canvas x:Name="DragCanvas" Background="Transparent"
                    MouseLeftButtonDown="OnCanvasMouseDown"
                    MouseMove="OnCanvasMouseMove"
                    MouseLeftButtonUp="OnCanvasMouseUp">
                <!-- Aradaki mesafe bölgesi -->
                <Rectangle x:Name="SpanRect" Fill="#2000E5FF" Height="140" Canvas.Top="0" />

                <!-- Sol çizgi -->
                <Line x:Name="LeftLine" Y1="0" Y2="140" Stroke="#00E5FF" StrokeThickness="2.5" />
                <Border x:Name="LeftHandle" Width="14" Height="28" Background="#00E5FF" CornerRadius="3"
                        Canvas.Top="56" Cursor="SizeWE" />

                <!-- Sağ çizgi -->
                <Line x:Name="RightLine" Y1="0" Y2="140" Stroke="#00E5FF" StrokeThickness="2.5" />
                <Border x:Name="RightHandle" Width="14" Height="28" Background="#00E5FF" CornerRadius="3"
                        Canvas.Top="56" Cursor="SizeWE" />

                <!-- Mesafe etiketi -->
                <TextBlock x:Name="DistanceLabel" FontWeight="Bold" FontSize="13" Foreground="#00E5FF"
                           Canvas.Top="8" />
            </Canvas>
        </Border>

        <!-- 3. Nesne Seçimi ve Uzunluk -->
        <WrapPanel Grid.Row="2" Margin="0,14,0,8" VerticalAlignment="Center">
            <TextBlock Text="Referans Nesne:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"
                       Foreground="{DynamicResource MutedTextBrush}" />
            <ComboBox ItemsSource="{Binding Presets}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedPreset}"
                      Width="210" Height="28" Margin="0,0,14,0" />

            <TextBlock Text="Gerçek Ölçü (mm):" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"
                       Foreground="{DynamicResource MutedTextBrush}" />
            <TextBox Text="{Binding KnownMillimetres, UpdateSourceTrigger=PropertyChanged}"
                     Width="80" Height="28" VerticalContentAlignment="Center" Margin="0,0,8,0" />
        </WrapPanel>

        <!-- 4. Sonuç Metni -->
        <Border Grid.Row="3" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6"
                Padding="12,8" Margin="0,4,0,12" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
            <TextBlock Text="{Binding ResultText}" FontSize="12.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
        </Border>

        <!-- 5. Butonlar -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Command="{Binding SaveCommand}" Content="Kaydet ve Kapat"
                    Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0" Padding="16,7" />
            <Button Command="{Binding CancelCommand}" Content="İptal"
                    Style="{StaticResource SecondaryButtonStyle}" Padding="16,7" />
        </StackPanel>
    </Grid>
</Window>
