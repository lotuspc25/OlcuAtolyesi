<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="OlcuAtolyesi.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:OlcuAtolyesi.Views"
    Title="Ölçü Atölyesi"
    FlyoutBehavior="Disabled">

    <TabBar Route="main">
        <ShellContent
            Title="Ana Sayfa"
            Icon="home.png"
            Route="home"
            ContentTemplate="{DataTemplate views:HomePage}" />
        <ShellContent
            Title="Araçlar"
            Icon="tools.png"
            Route="tools"
            ContentTemplate="{DataTemplate views:ToolsPage}" />
        <ShellContent
            Title="Projeler"
            Icon="projects.png"
            Route="projects"
            ContentTemplate="{DataTemplate views:ProjectsPage}" />
        <ShellContent
            Title="Ayarlar"
            Icon="settings.png"
            Route="settings"
            ContentTemplate="{DataTemplate views:SettingsPage}" />
    </TabBar>
</Shell>
